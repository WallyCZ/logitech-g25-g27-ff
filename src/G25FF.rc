#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"  // generated by build.cmd

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
FILEVERSION     G25FF_VERSION
PRODUCTVERSION  G25FF_VERSION
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WallyCZ"
            VALUE "FileDescription", "Logitech G25/G27/DFGT force feedback driver"
            VALUE "FileVersion", G25FF_VERSION_STRING
            VALUE "InternalName", "G25FF"
            VALUE "OriginalFilename", "G25FF.dll"
            VALUE "ProductName", "Logitech G25/G27/DFGT Force Feedback Driver"
            VALUE "ProductVersion", G25FF_VERSION_STRING
            VALUE "LegalCopyright", "https://github.com/WallyCZ/logitech-g25-g27-ff"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_FORCE DIALOGEX 0, 0, 252, 290
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CAPTION
CAPTION "Force Feedback"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Wheel", -1, 7, 7, 238, 34
    LTEXT           "Rotation", -1, 15, 23, 52, 8
    CONTROL         "", IDC_RANGE, TRACKBAR_CLASS, TBS_HORZ | WS_TABSTOP, 67, 19, 140, 15
    RTEXT           "", IDC_RANGE_VALUE, 209, 23, 28, 8

    GROUPBOX        "Effect strength", -1, 7, 47, 238, 104
    LTEXT           "All effects", -1, 15, 63, 52, 8
    CONTROL         "", IDC_GAIN, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 67, 59, 140, 15
    RTEXT           "", IDC_GAIN_VALUE, 209, 63, 28, 8
    LTEXT           "Springs", -1, 15, 83, 52, 8
    CONTROL         "", IDC_SPRING, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 67, 79, 140, 15
    RTEXT           "", IDC_SPRING_VALUE, 209, 83, 28, 8
    LTEXT           "Dampers", -1, 15, 103, 52, 8
    CONTROL         "", IDC_DAMPER, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 67, 99, 140, 15
    RTEXT           "", IDC_DAMPER_VALUE, 209, 103, 28, 8
    AUTOCHECKBOX    "Use the wheel's friction effect (otherwise friction plays as damper)", IDC_HARDWARE_FRICTION, 15, 120, 225, 10
    AUTOCHECKBOX    "Reverse the direction of forces", IDC_INVERT, 15, 134, 225, 10

    GROUPBOX        "Centering spring", -1, 7, 157, 238, 66
    AUTOCHECKBOX    "Center the wheel when no game uses force feedback", IDC_AUTOCENTER, 15, 171, 222, 10
    LTEXT           "Strength", IDC_AUTOCENTER_LABEL, 15, 191, 52, 8
    CONTROL         "", IDC_AUTOCENTER_STRENGTH, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 67, 187, 140, 15
    RTEXT           "", IDC_AUTOCENTER_VALUE, 209, 191, 28, 8
    LTEXT           "Games with force feedback center the wheel themselves.", -1, 15, 208, 222, 8

    GROUPBOX        "Test", -1, 7, 229, 238, 36
    PUSHBUTTON      "Push &left", IDC_TEST_LEFT, 15, 243, 52, 14
    PUSHBUTTON      "Push &right", IDC_TEST_RIGHT, 72, 243, 52, 14
    PUSHBUTTON      "R&umble", IDC_TEST_RUMBLE, 129, 243, 52, 14
    PUSHBUTTON      "&Spring", IDC_TEST_SPRING, 186, 243, 52, 14

    LTEXT           "Apply takes effect right away, also in a running game.", -1, 7, 274, 170, 8
    PUSHBUTTON      "&Defaults", IDC_DEFAULTS, 185, 270, 60, 14
END
